# GEMINI_API_KEY: Required for the AI concierge endpoint (server-side Gemini calls).
# Server-side only — never exposed to the browser bundle. Generate a key at
# https://aistudio.google.com/apikey and keep it in a local .env (git-ignored).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port for the production Express server (npm start). Defaults to 3000.
PORT="3000"

# GEMINI_MODEL: Optional override for the concierge model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this storefront is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
